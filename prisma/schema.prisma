datasource db {
    provider = "postgresql"
}

generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

// Starter models — replace with your own
// @@map(...) en cada modelo apunta a las tablas ya existentes en la base real
// (creadas en minúscula: user, post, priceRange, etc.) para no perder datos.
model User {
    id    Int    @id @default(autoincrement())
    email String @unique
    posts Post[]

    @@map("user")
}

model Post {
    id       Int    @id @default(autoincrement())
    title    String
    authorId Int
    author   User   @relation(fields: [authorId], references: [id])

    @@map("post")
}

// La columna real en la base es texto con un CHECK constraint ('LOW_COST'/'EXPRESS'),
// no un enum nativo de Postgres — se modela como String para no forzar una conversión
// de tipo de columna sobre datos ya existentes. Los valores válidos se validan en la
// app (ver src/lib/pricing.ts y src/actions/quote.ts).
model PriceRange {
    id             Int    @id @default(autoincrement())
    serviceType    String
    distanciaMinKm Float
    distanciaMaxKm Float
    precioRango    Float
    descripcion    String

    @@map("priceRange")
}

model Feedback {
    id            Int      @id @default(autoincrement())
    page          String
    componentPath String
    currentText   String
    suggestedEdit String
    createdAt     DateTime @default(now())

    @@map("feedback")
}

model ImageMetadata {
    id                 Int                  @id @default(autoincrement())
    relativePath       String               @unique // Ej. "/express-hero-inline.png" o "/images/card-mapa.webp"
    currentDescription String
    createdAt          DateTime             @default(now())
    updatedAt          DateTime             @updatedAt
    promptSuggestions  AiPromptSuggestion[]

    @@map("imageMetadata")
}

model AiPromptSuggestion {
    id          Int           @id @default(autoincrement())
    promptText  String
    modelUsed   String? // Ej. "nano-banana", "imagen-3", "auto"
    aspectRatio String? // Ej. "16:9"
    imageId     Int
    image       ImageMetadata @relation(fields: [imageId], references: [id], onDelete: Cascade)
    createdAt   DateTime      @default(now())

    @@map("aiPromptSuggestion")
}
